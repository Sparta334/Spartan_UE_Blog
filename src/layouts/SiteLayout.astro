---
import { Icon } from "astro-icon/components";

import "@/styles/site.css";
import "@/styles/expressive-code.css";
import { siteConfig } from "@/config";
import { profile } from "@/data/profile";
import { url } from "@/utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	// 当前所在栏目，用于导航高亮
	section?: "home" | "topics" | "projects" | "achievements" | "about";
	ogType?: "website" | "article";
}

const { title, description, section, ogType = "website" } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || profile.bio;

const nav = [
	{ id: "home", name: "首页", href: url("/") },
	{ id: "topics", name: "技术专题", href: url("/topics/") },
	{ id: "projects", name: "项目", href: url("/projects/") },
	{ id: "achievements", name: "全成就", href: url("/achievements/") },
	{ id: "about", name: "关于我", href: url("/about/") },
] as const;

const github = profile.links.find((l) => l.name === "GitHub");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN" class="dark" data-theme="github-dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#15181c" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<link rel="icon" href={url("/favicon/favicon.ico")} />
		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={url("/rss.xml")} />
		<link rel="sitemap" href={url("/sitemap-index.xml")} />
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="container-site flex h-full items-center gap-4">
				<a href={url("/")} class="site-logo">
					<span class="site-logo-mark">UE</span>
					<span class="hidden sm:inline">{siteConfig.title}</span>
				</a>
				<nav class="site-nav" aria-label="主导航">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={section === item.id ? "page" : undefined}>
								{item.name}
							</a>
						))
					}
				</nav>
				{
					github?.url && (
						<a href={github.url} class="site-header-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
							<Icon name="fa7-brands:github" class="h-5 w-5" />
						</a>
					)
				}
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container-site flex flex-col gap-2 py-8 text-sm sm:flex-row sm:items-center sm:justify-between">
				<p>© {year} {profile.name}</p>
				<p class="flex flex-wrap gap-x-3 gap-y-1">
					<a href={url("/rss.xml")}>RSS</a>
					<a href={url("/archive/")}>全部文章</a>
					<span>
						基于 <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> 与
						<a href="https://github.com/LyraVoid/Mizuki" target="_blank" rel="noopener noreferrer">Mizuki</a> 主题构建
					</span>
				</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-h);
		background: var(--site-bg-2);
		border-bottom: 1px solid var(--border);
	}
	.site-logo {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 0.6rem;
		font-weight: 600;
		color: var(--text);
		white-space: nowrap;
	}
	.site-logo-mark {
		display: inline-grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 4px;
		border: 1px solid var(--border-strong);
		background: var(--panel);
		color: var(--accent-strong);
		font-size: 11px;
		letter-spacing: 0.04em;
	}
	.site-nav {
		display: flex;
		flex: 1;
		gap: 0.25rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	/* 用 margin 靠右，避免内容溢出时第一项被裁掉 */
	.site-nav a:first-child {
		margin-left: auto;
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
	.site-nav a {
		flex-shrink: 0;
		padding: 0.35rem 0.65rem;
		border-radius: 4px;
		font-size: 0.875rem;
		color: var(--text-2);
		white-space: nowrap;
	}
	.site-nav a:hover {
		color: var(--text);
		background: var(--panel);
	}
	.site-nav a[aria-current="page"] {
		color: var(--accent-strong);
		background: var(--accent-soft);
	}
	.site-header-icon {
		display: none;
		color: var(--text-2);
	}
	.site-header-icon:hover {
		color: var(--text);
	}
	@media (min-width: 640px) {
		.site-header-icon {
			display: inline-flex;
		}
	}
	@media (max-width: 480px) {
		.site-nav a {
			padding: 0.35rem 0.45rem;
			font-size: 0.8125rem;
		}
	}
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		background: var(--site-bg-2);
		color: var(--text-3);
	}
	.site-footer a {
		color: var(--text-2);
	}
	.site-footer a:hover {
		color: var(--accent-strong);
	}
</style>
