---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";

import { projectsData } from "../../data/projects";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const entries = await getCollection("projects");
	return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const project = projectsData.find((p) => p.id === entry.id);
const { Content, headings } = await render(entry);
const title = project?.title ?? entry.id;
---

<MainGridLayout title={title} description={project?.description} headings={headings}>
	<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full onload-animation">
		<a href={url("/projects/")} class="inline-flex items-center gap-1 text-sm text-50 hover:text-(--primary) transition">
			<Icon name="material-symbols:arrow-back-rounded" class="w-4 h-4" /> 專案展示
		</a>
		<h1 class="mt-3 text-3xl font-bold text-90">{title}</h1>
		{project?.description && <p class="mt-2 text-75">{project.description}</p>}
		{
			project && (
				<div class="mt-4 flex flex-wrap items-center gap-2">
					{project.techStack.map((tech) => (
						<span class="px-2 py-1 text-xs rounded-md bg-(--primary)/10 text-(--primary) font-medium">{tech}</span>
					))}
					{project.visitUrl && (
						<a
							href={project.visitUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="project-game-link ml-auto inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold"
						>
							<Icon name="material-symbols:sports-esports" class="w-4 h-4" /> 遊戲連結
						</a>
					)}
				</div>
			)
		}
		<hr class="my-6 border-dashed border-black/10 dark:border-white/10" />
		<Markdown>
			<Content />
		</Markdown>
	</div>
</MainGridLayout>

<style>
	.project-game-link {
		background: #16a34a;
		color: #fff;
	}
	.project-game-link:hover {
		background: #15803d;
	}
</style>
