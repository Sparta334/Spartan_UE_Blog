---
import PostList from "@/components/site/PostList.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getLatestPosts } from "@/utils/topic-utils";
import { url } from "@/utils/url-utils";

const posts = await getLatestPosts();
---

<SiteLayout title="全部文章" section="topics">
	<div class="container-site pt-10">
		<h1 class="page-title">全部文章</h1>
		<p class="page-lead" id="archive-filter-note">共 {posts.length} 篇。</p>
		<p class="mb-4 hidden text-sm" id="archive-filter-clear">
			<a href={url("/archive/")} class="text-(--accent-strong)">清除标签筛选</a>
		</p>
		<div id="archive-list">
			<PostList posts={posts} />
		</div>
	</div>
</SiteLayout>

<script>
	// 支持 /archive/?tag=xxx 按标签筛选
	const tag = new URLSearchParams(location.search).get("tag");
	if (tag) {
		const items = document.querySelectorAll<HTMLElement>("#archive-list li[data-tags]");
		let count = 0;
		items.forEach((li) => {
			const match = (li.dataset.tags ?? "").split("|").includes(tag);
			li.hidden = !match;
			if (match) count++;
		});
		const note = document.getElementById("archive-filter-note");
		if (note) note.textContent = `标签「${tag}」：${count} 篇。`;
		document.getElementById("archive-filter-clear")?.classList.remove("hidden");
	}
</script>
