---
import { Icon } from "astro-icon/components";

import Markdown from "@/components/misc/Markdown.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { renderPostContent } from "@/utils/content-renderer";
import { getSortedPosts } from "@/utils/content-utils";
import {
	formatPostDate,
	getTopicGroups,
	type Post,
	postUrl,
	topicOf,
	topicUrl,
} from "@/utils/topic-utils";
import { removeFileExtension, url } from "@/utils/url-utils";
import { profile } from "@/data/profile";
import { siteConfig } from "@/config";

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: Post };
const { Content, headings } = await renderPostContent(entry, {
	target: "page",
	site: Astro.site ?? siteConfig.siteURL,
});

const groups = await getTopicGroups();
const topic = topicOf(entry);
const topicPosts = groups.find((g) => g.topic.id === topic.id)?.posts ?? [];
const index = topicPosts.findIndex((p) => p.id === entry.id);
const prev = index > 0 ? topicPosts[index - 1] : undefined;
const next = index >= 0 && index < topicPosts.length - 1 ? topicPosts[index + 1] : undefined;

// 标题文字末尾会带上锚点符号「#」，目录里去掉
const toc = headings
	.filter((h) => h.depth >= 2 && h.depth <= 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, "").trim() }));
const published = formatPostDate(entry, "published");
const updated = formatPostDate(entry, "updated");

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description,
	keywords: entry.data.tags,
	author: { "@type": "Person", name: profile.name },
	datePublished: entry.data.published.toISOString(),
	...(entry.data.updated && { dateModified: entry.data.updated.toISOString() }),
};
---

<SiteLayout title={entry.data.title} description={entry.data.description} section="topics" ogType="article">
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<div class="doc container-site">
		<!-- 左侧：专题与文章导航 -->
		<aside class="doc-nav" aria-label="专题导航">
			<details class="doc-drawer" data-drawer>
				<summary>
					<Icon name="material-symbols:menu-book-outline" class="h-4 w-4" />
					专题导航
				</summary>
				<nav class="doc-nav-inner">
					{
						groups.map((g) => (
							<div class="doc-nav-group">
								<a class="doc-nav-topic" href={topicUrl(g.topic)}>
									{g.topic.name}
								</a>
								{g.posts.length > 0 ? (
									<ul>
										{g.posts.map((p) => (
											<li>
												<a href={postUrl(p)} aria-current={p.id === entry.id ? "page" : undefined}>
													{p.data.title}
												</a>
											</li>
										))}
									</ul>
								) : (
									<p class="doc-nav-empty">暂无文章</p>
								)}
							</div>
						))
					}
				</nav>
			</details>
		</aside>

		<!-- 中间：正文 -->
		<article class="doc-main">
			<nav class="breadcrumb">
				<a href={url("/topics/")}>技术专题</a>
				<span>/</span>
				<a href={topicUrl(topic)}>{topic.name}</a>
			</nav>
			<h1 class="doc-title" data-pagefind-meta="title">{entry.data.title}</h1>
			{entry.data.description && <p class="doc-lead">{entry.data.description}</p>}

			<dl class="doc-meta">
				<div>
					<dt>适用版本</dt>
					<dd>{entry.data.ueVersion ? `UE ${entry.data.ueVersion}` : <span class="muted">未标注</span>}</dd>
				</div>
				<div>
					<dt>发布</dt>
					<dd>{published}</dd>
				</div>
				<div>
					<dt>更新</dt>
					<dd>{updated || published}</dd>
				</div>
				{
					entry.data.tags.length > 0 && (
						<div class="doc-meta-tags">
							<dt>标签</dt>
							<dd class="flex flex-wrap gap-1.5">
								{entry.data.tags.map((tag) => (
									<a class="tag" href={url(`/archive/?tag=${encodeURIComponent(tag)}`)}>
										{tag}
									</a>
								))}
							</dd>
						</div>
					)
				}
			</dl>

			{
				toc.length > 0 && (
					<details class="doc-drawer doc-toc-mobile">
						<summary>
							<Icon name="material-symbols:toc" class="h-4 w-4" />
							本页目录
						</summary>
						<ul class="doc-toc-list">
							{toc.map((h) => (
								<li class:list={[`depth-${h.depth}`]}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ul>
					</details>
				)
			}

			<Markdown class="doc-content">
				<Content />
			</Markdown>

			<nav class="doc-pager" aria-label="上一篇 / 下一篇">
				{
					prev ? (
						<a href={postUrl(prev)}>
							<span>上一篇</span>
							{prev.data.title}
						</a>
					) : (
						<span />
					)
				}
				{
					next ? (
						<a href={postUrl(next)} class="text-right">
							<span>下一篇</span>
							{next.data.title}
						</a>
					) : (
						<span />
					)
				}
			</nav>
			<p class="mt-4 text-sm">
				<a href={topicUrl(topic)} class="inline-flex items-center gap-1 text-(--accent-strong) hover:underline">
					<Icon name="material-symbols:arrow-back" class="h-4 w-4" />
					返回「{topic.name}」专题
				</a>
			</p>
		</article>

		<!-- 右侧：本页目录 -->
		<aside class="doc-toc" aria-label="本页目录">
			{
				toc.length > 0 && (
					<div class="doc-toc-inner">
						<p class="doc-toc-title">本页目录</p>
						<ul class="doc-toc-list" data-toc>
							{toc.map((h) => (
								<li class:list={[`depth-${h.depth}`]}>
									<a href={`#${h.slug}`} data-slug={h.slug}>
										{h.text}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</aside>
	</div>
</SiteLayout>

<script>
	// 桌面端左侧导航始终展开；手机端默认收起
	const desktop = window.matchMedia("(min-width: 1024px)");
	const drawer = document.querySelector<HTMLDetailsElement>("[data-drawer]");
	const syncDrawer = () => {
		if (drawer) drawer.open = desktop.matches;
	};
	syncDrawer();
	desktop.addEventListener("change", syncDrawer);

	// 手机端点目录链接后收起目录
	document.querySelectorAll<HTMLDetailsElement>(".doc-toc-mobile").forEach((d) => {
		d.addEventListener("click", (e) => {
			if ((e.target as Element).closest("a")) d.open = false;
		});
	});

	// 右侧目录高亮当前章节
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[data-slug]"));
	const targets = links
		.map((a) => document.getElementById(a.dataset.slug ?? ""))
		.filter((el): el is HTMLElement => !!el);
	if (targets.length > 0) {
		const setActive = () => {
			const offset = 100;
			let current = targets[0];
			for (const t of targets) {
				if (t.getBoundingClientRect().top - offset <= 0) current = t;
			}
			links.forEach((a) => a.classList.toggle("active", a.dataset.slug === current.id));
		};
		setActive();
		window.addEventListener("scroll", setActive, { passive: true });
	}
</script>

<style>
	.doc {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0 2.5rem;
		padding-top: 1.5rem;
	}
	.doc-main {
		min-width: 0;
	}
	.doc-title {
		font-size: 1.85rem;
		font-weight: 600;
		line-height: 1.3;
		color: #e6eaee;
	}
	.doc-lead {
		margin-top: 0.5rem;
		color: var(--text-2);
	}
	.doc-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 2rem;
		margin: 1.25rem 0 1.5rem;
		padding: 0.8rem 1rem;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		font-size: 0.85rem;
	}
	.doc-meta dt {
		font-size: 0.72rem;
		color: var(--text-3);
	}
	.doc-meta dd {
		color: var(--text);
	}
	.doc-content {
		margin-top: 0.5rem;
	}

	/* 手机端抽屉 */
	.doc-drawer {
		margin-bottom: 1rem;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.doc-drawer > summary {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		font-size: 0.875rem;
		color: var(--text-2);
		cursor: pointer;
		list-style: none;
	}
	.doc-drawer > summary::-webkit-details-marker {
		display: none;
	}
	.doc-drawer[open] > summary {
		border-bottom: 1px solid var(--border);
	}

	/* 左侧导航 */
	.doc-nav-inner {
		padding: 0.75rem 0.9rem;
	}
	.doc-nav-group + .doc-nav-group {
		margin-top: 1rem;
	}
	.doc-nav-topic {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--text-3);
	}
	.doc-nav-topic:hover {
		color: var(--accent-strong);
	}
	.doc-nav ul a {
		display: block;
		padding: 0.25rem 0.6rem;
		border-left: 2px solid var(--border);
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--text-2);
	}
	.doc-nav ul a:hover {
		color: var(--text);
	}
	.doc-nav ul a[aria-current="page"] {
		border-left-color: var(--accent);
		color: var(--accent-strong);
		background: var(--accent-soft);
	}
	.doc-nav-empty {
		padding-left: 0.7rem;
		font-size: 0.8rem;
		color: var(--text-3);
	}

	/* 目录 */
	.doc-toc {
		display: none;
	}
	.doc-toc-title {
		margin-bottom: 0.5rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--text-3);
	}
	.doc-toc-list {
		padding: 0.4rem 0;
	}
	.doc-toc-mobile .doc-toc-list {
		padding: 0.5rem 0.9rem;
	}
	.doc-toc-list a {
		display: block;
		padding: 0.2rem 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--text-2);
	}
	.doc-toc-list a:hover,
	.doc-toc-list a.active {
		color: var(--accent-strong);
	}
	.doc-toc-list .depth-3 a {
		padding-left: 0.9rem;
	}

	/* 上一篇 / 下一篇 */
	.doc-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.doc-pager a {
		display: block;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--panel);
		font-size: 0.9rem;
		color: var(--text);
	}
	.doc-pager a:hover {
		border-color: var(--accent);
	}
	.doc-pager a span {
		display: block;
		font-size: 0.75rem;
		color: var(--text-3);
	}

	@media (min-width: 1024px) {
		.doc {
			grid-template-columns: 220px minmax(0, 1fr);
		}
		.doc-nav > .doc-drawer {
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
			max-height: calc(100vh - var(--header-h) - 3rem);
			overflow-y: auto;
			margin: 0;
			background: none;
			border: none;
		}
		.doc-nav > .doc-drawer > summary {
			display: none;
		}
		.doc-nav-inner {
			padding: 0;
		}
	}
	@media (min-width: 1280px) {
		.doc {
			grid-template-columns: 220px minmax(0, 1fr) 200px;
		}
		.doc-toc {
			display: block;
		}
		.doc-toc-inner {
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
			max-height: calc(100vh - var(--header-h) - 3rem);
			overflow-y: auto;
		}
		.doc-toc-mobile {
			display: none;
		}
	}
</style>
