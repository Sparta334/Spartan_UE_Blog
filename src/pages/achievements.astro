---
import { PageHeader } from "@components/features/page-header";
import SteamShowcase from "@components/features/steam/SteamShowcase.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="全成就" description="Steam 全成就達成的遊戲">
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
			<PageHeader title="全成就" />
			<SteamShowcase variant="grid" class="mt-4 onload-animation" />
		</div>
	</div>
</MainGridLayout>
