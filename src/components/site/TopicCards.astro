---
import { Icon } from "astro-icon/components";

import { type TopicGroup, topicUrl } from "@/utils/topic-utils";

interface Props {
	groups: TopicGroup[];
}
const { groups } = Astro.props;
---

<div class="topic-grid">
	{
		groups.map(({ topic, posts }) => (
			<a class="topic-card panel" href={topicUrl(topic)}>
				<div class="flex items-center gap-2">
					<Icon name={topic.icon} class="h-5 w-5 text-(--accent-strong)" />
					<h3>{topic.name}</h3>
					<span class="ml-auto text-xs muted">{posts.length > 0 ? `${posts.length} 篇` : "暂无文章"}</span>
				</div>
				<p>{topic.description}</p>
			</a>
		))
	}
</div>

<style>
	.topic-grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}
	.topic-card {
		display: block;
		padding: 1rem 1.1rem;
		transition: border-color 0.15s;
	}
	.topic-card:hover {
		border-color: var(--accent);
	}
	.topic-card h3 {
		font-weight: 600;
		color: #e6eaee;
	}
	.topic-card p {
		margin-top: 0.4rem;
		font-size: 0.85rem;
		color: var(--text-2);
	}
</style>
