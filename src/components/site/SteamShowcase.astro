---
import { Icon } from "astro-icon/components";

import { profile } from "@/data/profile";
import { isPerfect, steamCoverUrl, steamGames, steamStoreUrl } from "@/data/steam-games";

interface Props {
	limit?: number;
}
const { limit } = Astro.props;

const perfect = steamGames
	.filter(isPerfect)
	.sort((a, b) => (b.completedAt ?? "").localeCompare(a.completedAt ?? ""));
const shown = limit ? perfect.slice(0, limit) : perfect;
const totalAchievements = perfect.reduce((sum, g) => sum + g.unlocked, 0);
const steamUrl = profile.links.find((l) => l.name === "Steam")?.url;
---

<div class="showcase panel">
	<div class="showcase-head">
		<div class="flex items-center gap-2">
			<Icon name="fa7-brands:steam" class="h-5 w-5 text-(--text-2)" />
			<span class="font-semibold">全成就展示柜</span>
		</div>
		<div class="showcase-stats">
			<div>
				<strong>{perfect.length}</strong>
				<span>全成就游戏</span>
			</div>
			<div>
				<strong>{totalAchievements}</strong>
				<span>累计成就</span>
			</div>
		</div>
	</div>

	{
		shown.length === 0 ? (
			<div class="pending m-4 py-10">
				<p>全成就游戏待填写</p>
				<p>
					在 <code>src/data/steam-games.ts</code> 添加游戏与成就数
				</p>
			</div>
		) : (
			<div class="game-grid">
				{shown.map((g) => (
					<a class="game-card" href={steamStoreUrl(g)} target="_blank" rel="noopener noreferrer">
						<img src={steamCoverUrl(g)} alt={g.name} loading="lazy" />
						<div class="game-info">
							<p class="game-name">{g.name}</p>
							<div class="game-meta">
								<span class="perfect-badge" title="已达成全成就">
									<Icon name="material-symbols:check" class="h-3 w-3" />
									全成就
								</span>
								<span>
									{g.unlocked} / {g.total}
								</span>
							</div>
							<p class="game-date">{g.completedAt ? `达成于 ${g.completedAt}` : "完成日期待填写"}</p>
						</div>
					</a>
				))}
			</div>
		)
	}

	{
		steamUrl && (
			<div class="showcase-foot">
				<a href={steamUrl} target="_blank" rel="noopener noreferrer">
					查看 Steam 个人资料
				</a>
			</div>
		)
	}
</div>

<style>
	.showcase {
		overflow: hidden;
	}
	.showcase-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding: 0.9rem 1rem;
		background: var(--panel-2);
		border-bottom: 1px solid var(--border);
	}
	.showcase-stats {
		display: flex;
		gap: 1.75rem;
	}
	.showcase-stats div {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.showcase-stats strong {
		font-size: 1.35rem;
		font-weight: 600;
		color: #e6eaee;
		font-variant-numeric: tabular-nums;
	}
	.showcase-stats span {
		font-size: 0.8rem;
		color: var(--text-3);
	}
	.game-grid {
		display: grid;
		gap: 0.75rem;
		padding: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
	.game-card {
		display: block;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--site-bg-2);
		transition: border-color 0.15s;
	}
	.game-card:hover {
		border-color: var(--accent);
	}
	.game-card img {
		width: 100%;
		aspect-ratio: 460 / 215;
		object-fit: cover;
		background: var(--panel-2);
	}
	.game-info {
		padding: 0.6rem 0.75rem 0.7rem;
	}
	.game-name {
		font-size: 0.9rem;
		font-weight: 600;
		color: #e6eaee;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.game-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.3rem;
		font-size: 0.8rem;
		color: var(--text-2);
		font-variant-numeric: tabular-nums;
	}
	.perfect-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0 0.4rem;
		border: 1px solid rgba(143, 169, 138, 0.45);
		border-radius: 3px;
		color: var(--success);
		font-size: 0.72rem;
		line-height: 1.25rem;
	}
	.game-date {
		margin-top: 0.2rem;
		font-size: 0.75rem;
		color: var(--text-3);
	}
	.showcase-foot {
		padding: 0.7rem 1rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
	}
	.showcase-foot a {
		color: var(--accent-strong);
	}
</style>
